{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sawm",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [{ "name": "REMINDERS", "class_name": "ReminderDevice" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReminderDevice"] }],
  "vars": {
    // The VAPID public key browsers subscribe with; its private half is the VAPID_PRIVATE_KEY secret.
    "VAPID_PUBLIC_KEY": "BDTLhrMOEWJxJ-DjHRBghCl-dYkwCXqljbgEgOGCpha36Tgepi_y1ApvgtlFeFlfzXAKGAOK_t0WyQZb4ok0iEo",
    "VAPID_SUBJECT": "https://sawm.rayyanarchy.workers.dev"
  }
}
