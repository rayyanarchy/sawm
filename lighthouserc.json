{
  "ci": {
    "collect": {
      "staticDistDir": "dist/client",
      "url": [
        "/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
